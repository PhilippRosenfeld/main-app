{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "main-app": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/assets"
            ],
            "styles": [
              "node_modules/@fontsource/unifrakturmaguntia/400.css",
              "node_modules/@fontsource/eb-garamond/400.css",
              "node_modules/@fontsource/eb-garamond/400-italic.css",
              "node_modules/@fontsource/eb-garamond/500.css",
              "node_modules/@fontsource/cinzel/400.css",
              "node_modules/@fontsource/cinzel/500.css",
              "node_modules/@fontsource/cinzel/600.css",
              "node_modules/@fontsource/cinzel-decorative/400.css",
              "node_modules/@fontsource/cormorant-garamond/400.css",
              "node_modules/@fontsource/cormorant-garamond/400-italic.css",
              "node_modules/@fontsource/cormorant-garamond/500.css",
              "node_modules/@fontsource/grenze-gotisch/700.css",
              "node_modules/@fontsource/grenze-gotisch/900.css",
              "node_modules/@fontsource/ibm-plex-mono/400.css",
              "node_modules/@fontsource/ibm-plex-mono/500.css",
              "node_modules/bootstrap-icons/font/bootstrap-icons.css",
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "main-app:build:production"
            },
            "development": {
              "buildTarget": "main-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
